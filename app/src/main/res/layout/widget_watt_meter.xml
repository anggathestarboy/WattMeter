<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header: Logo, Battery %, and Refresh Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="WattMeter Icon"
            android:src="@drawable/ic_widget_bolt" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="WattMeter"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_battery_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="#1E293B"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="85%"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_refresh_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Segarkan Data Daya"
            android:padding="4dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <!-- Center: Main Wattage Value and Charging Speed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_watt_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- W"
            android:textColor="#00E5FF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Mendeteksi Daya Masuk..."
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="normal" />
    </LinearLayout>

    <!-- Metrics Row: Voltage, Current, Temp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#14213d"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_voltage_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="4.20 V"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:background="#334155" />

        <TextView
            android:id="@+id/widget_current_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="1800 mA"
            android:textColor="#4ADE80"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:background="#334155" />

        <TextView
            android:id="@+id/widget_temp_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="32.0°C"
            android:textColor="#F59E0B"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Footer: Last update indicator -->
    <TextView
        android:id="@+id/widget_update_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Diperbarui Baru Saja • Ketuk Buka"
        android:textColor="#64748B"
        android:textSize="9sp" />

</LinearLayout>
